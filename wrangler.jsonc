{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizuro-site-live",
  "main": "src/notify.js",
  "compatibility_date": "2026-08-02",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTNER_REFERRALS",
        "class_name": "PartnerReferrals"
      }
    ]
  },
  "exports": {
    "PartnerReferrals": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "send_email": [
    {
      "name": "PARTNER_NOTIFICATIONS",
      "destination_address": "info@kaizuro.com",
      "allowed_sender_addresses": [
        "info@kaizuro.com"
      ]
    }
  ]
}
