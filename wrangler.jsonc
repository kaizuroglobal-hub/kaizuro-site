{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizuro-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "staging.kaizuro.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  }
}
