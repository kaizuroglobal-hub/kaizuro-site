{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizuro-site-live",
  "main": "src/main.js",
  "compatibility_date": "2026-08-02",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTNER_REFERRALS",
        "class_name": "PartnerReferrals"
      }
    ]
  },
  "exports": {
    "PartnerReferrals": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
