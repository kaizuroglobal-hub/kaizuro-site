{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staging-kaizuro-com",
  "main": "src/site-spacing.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "vars": {
    "KZ_ENVIRONMENT": "staging",
    "KZ_TEST_DEALER_EMAIL": "w3protocol@proton.me"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PARTNER_REFERRALS",
        "class_name": "PartnerReferrals"
      }
    ]
  },
  "exports": {
    "PartnerReferrals": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
